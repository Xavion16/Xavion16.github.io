# ARION — ortam değişkenleri şablonu
# Gerçek değerler apps/backend/.env ve apps/storefront/.env.local dosyalarında durur (git'e girmez).
# Bu dosyada GERÇEK ANAHTAR OLMAZ.

# ── Yerel veritabanı (infra/db, Docker'sız — DECISIONS #006) ──────────────
ARION_DB_PORT=5432
ARION_DB_USER=postgres
ARION_DB_PASSWORD=arion_dev
ARION_DB_NAME=arion

# ── apps/backend/.env ──────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:arion_dev@localhost:5432/arion
# REDIS_URL=redis://localhost:6379   # Faz 0'da yok; Medusa in-memory event bus/cache kullanır
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# ── apps/storefront/.env.local ─────────────────────────────────────────────
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=tr
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# ── Adapter modları (mock|live) — sonraki fazlar ──────────────────────────
PAYMENT_ADAPTER=mock
SHIPPING_ADAPTER=mock
IYS_ADAPTER=mock
INVOICE_ADAPTER=mock
AI_CHAT_ADAPTER=mock
MEDIA_GEN_ADAPTER=mock
IMAGE_TO_3D_ADAPTER=mock

# ── İndirim referans fiyatı (Bölüm 7.3) ───────────────────────────────────
DISCOUNT_REFERENCE_DAYS=10
