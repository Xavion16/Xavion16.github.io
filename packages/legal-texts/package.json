{
  "name": "@arion/legal-texts",
  "version": "1.0.0",
  "private": true,
  "description": "Versiyonlu yasal metinler (KVKK, mesafeli satış, çerez), dinamik sözleşme doldurucu ve PDF üretimi",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "default": "./dist/pdf.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "dejavu-fonts-ttf": "2.37.3",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.2",
    "vitest": "^5.1.1"
  }
}
