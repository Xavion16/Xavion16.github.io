{
  "name": "arion",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "db": "pnpm --filter @arion/db start",
    "typecheck": "turbo typecheck",
    "e2e": "pnpm --filter @arion/e2e e2e",
    "e2e:install": "pnpm --filter @arion/e2e e2e:install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "e2e:a11y": "pnpm --filter @arion/e2e e2e:a11y",
    "e2e:lighthouse": "pnpm --filter @arion/e2e e2e:lighthouse"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.7",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14",
    "vite": "7.3.7"
  }
}
